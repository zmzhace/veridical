{
  "name": "@veridical/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "dev": "VERIDICAL_MODE=development tsx watch src/index.ts",
    "start": "node dist/server.cjs",
    "test": "vitest run",
    "test:production": "pnpm build && node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@veridical/schema": "workspace:*",
    "@veridical/store": "workspace:*",
    "@veridical/spec": "workspace:*",
    "@veridical/replay": "workspace:*",
    "@veridical/llm": "workspace:*",
    "@veridical/eval": "workspace:*",
    "@veridical/memory": "workspace:*",
    "@veridical/runtime": "workspace:*",
    "@veridical/rl": "workspace:*",
    "@veridical/tools": "workspace:*",
    "fastify": "5.12.1",
    "@fastify/cors": "11.3.0",
    "better-sqlite3": "13.0.3",
    "zod": "^3.23.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "esbuild": "0.28.2",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0",
    "@types/node": "^26.2.0"
  }
}
