{
  "name": "@veridical/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "dev": "VERIDICAL_MODE=development node --env-file-if-exists=../../.env.local --watch --import tsx src/index.ts",
    "dev:production": "VERIDICAL_MODE=production tsx watch src/index.ts",
    "start": "node dist/server.cjs",
    "start:research": "VERIDICAL_MODE=development node --env-file-if-exists=../../.env.local dist/server.cjs",
    "start:production": "VERIDICAL_MODE=production node dist/server.cjs",
    "test": "vitest run",
    "test:llm:live": "node --env-file=../../.env.local --import tsx scripts/live-llm.mjs",
    "test:production": "pnpm build && node scripts/smoke-production.mjs",
    "test:production:postgres": "tsx scripts/smoke-postgres-business.mjs",
    "test:production:live": "node --env-file=../../.env.local --import tsx scripts/smoke-postgres-live.mjs",
    "test:infrastructure": "tsx scripts/smoke-infrastructure.mjs",
    "db:migrate:postgres": "tsx scripts/migrate-postgres.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@fastify/cors": "11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@veridical/eval": "workspace:*",
    "@veridical/knowledge": "workspace:*",
    "@veridical/llm": "workspace:*",
    "@veridical/memory": "workspace:*",
    "@veridical/replay": "workspace:*",
    "@veridical/runtime": "workspace:*",
    "@veridical/schema": "workspace:*",
    "@veridical/spec": "workspace:*",
    "@veridical/store": "workspace:*",
    "@veridical/tools": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "ioredis": "^5.4.0",
    "jose": "^6.2.10",
    "mammoth": "^1.12.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "yaml": "^2.8.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.10.0",
    "esbuild": "0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
